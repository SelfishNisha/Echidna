NAME      := Echidna
SRC_DIR   := src
INC_DIR   := include
BUILD_DIR := build
BIN_DIR   := bin

ifeq ($(OS),Windows_NT)
    CXX       ?= g++
    TARGET    := $(BIN_DIR)/$(NAME).dll
    JNI_OS    := win32
    LDLIBS    := -lkernel32 -luser32 -lgdi32 -lopengl32
    LDFLAGS_P := -static-libgcc -static-libstdc++ -Wl,--kill-at
    MKDIR     = if not exist "$(subst /,\,$(1))" mkdir "$(subst /,\,$(1))"
    RMDIR     = if exist "$(subst /,\,$(1))" rmdir /S /Q "$(subst /,\,$(1))"
else
    CXX       ?= g++
    TARGET    := $(BIN_DIR)/lib$(NAME).so
    JNI_OS    := linux
    LDLIBS    := -lGL
    LDFLAGS_P :=
    MKDIR     = mkdir -p $(1)
    RMDIR     = rm -rf $(1)
endif

ifndef JAVA_HOME
    $(error JAVA_HOME is not set. Point it at a JDK so jni.h can be found)
endif
JNI_INC := -I"$(JAVA_HOME)/include" -I"$(JAVA_HOME)/include/$(JNI_OS)"

# --- Flags ----------------------------------------------------
STD       := -std=c++17
WARN      := -Wall -Wextra -Wpedantic
CXXFLAGS  := $(STD) $(WARN) -I$(INC_DIR) $(JNI_INC) -fPIC -MMD -MP
LDFLAGS   := -shared $(LDFLAGS_P)

# Build mode: make MODE=debug  (default: release)
MODE ?= release
ifeq ($(MODE),debug)
    CXXFLAGS += -O0 -g3 -DDEBUG
else
    CXXFLAGS += -O2 -DNDEBUG -fvisibility=hidden -ffunction-sections -fdata-sections
    LDFLAGS  += -Wl,--gc-sections -s
endif

# --- Sources / objects ----------------------------------------
SRCS := $(wildcard $(SRC_DIR)/*.cpp) $(wildcard $(SRC_DIR)/*/*.cpp)
OBJS := $(patsubst $(SRC_DIR)/%.cpp,$(BUILD_DIR)/%.o,$(SRCS))
DEPS := $(OBJS:.o=.d)

# --- Rules ----------------------------------------------------
.PHONY: all clean rebuild info

all: $(TARGET)

$(TARGET): $(OBJS) | $(BIN_DIR)
	$(CXX) $(OBJS) -o $@ $(LDFLAGS) $(LDLIBS)
	@echo Built $@ [$(MODE)]

$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cpp
	@$(call MKDIR,$(dir $@))
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BIN_DIR):
	@$(call MKDIR,$@)

clean:
	@$(call RMDIR,$(BUILD_DIR))
	@$(call RMDIR,$(BIN_DIR))

rebuild: clean all

info:
	@echo Target : $(TARGET)
	@echo Mode   : $(MODE)
	@echo Sources: $(SRCS)

-include $(DEPS)